# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resumepilot?schema=public"

# LLM Gateway Configuration (R3: Open-weight default)
# Options: "fake" (default for offline/testing) | "openweight" | "gemini"
LLM_PROVIDER="fake"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Open-Weight Inference Endpoint (Ollama / vLLM / LM Studio)
OPENWEIGHT_BASE_URL="http://localhost:11434/v1"
OPENWEIGHT_API_KEY="local-bearer-key"
OPENWEIGHT_MODEL="gemma2:9b"

# Auth.js / NextAuth
NEXTAUTH_SECRET="development-secret-placeholder-min-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NODE_ENV="development"
